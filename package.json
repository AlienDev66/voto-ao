{
  "name": "votoao",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "esbuild prisma/seed.ts --bundle --platform=node --format=cjs --outfile=prisma/seed.cjs --external:@prisma/client && node prisma/seed.cjs",
    "db:reset": "prisma migrate reset --force",
    "ingest": "node scripts/ingest/run.mjs",
    "ingest:crawl": "node scripts/ingest/crawl.mjs",
    "ingest:fetch": "node scripts/ingest/fetch.mjs",
    "ingest:import-text": "node scripts/ingest/import-text.mjs",
    "ingest:parse": "node scripts/ingest/parse.mjs",
    "ingest:publish": "node scripts/ingest/publish.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.5.438",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.15.9",
  "prisma": {
    "seed": "pnpm db:seed"
  }
}
